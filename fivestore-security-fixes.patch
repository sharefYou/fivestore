diff --git a/.env.example b/.env.example
index 9d8f0d9..c2f8e1a 100644
--- a/.env.example
+++ b/.env.example
@@ -1,7 +1,7 @@
 APP_NAME="Five Store"
-APP_ENV=local
+APP_ENV=production
 APP_KEY=
-APP_DEBUG=true
+APP_DEBUG=false
 # Must match the hostname the site is served from.
 APP_URL=http://localhost:8000
 
@@ -32,11 +32,11 @@ DB_PASSWORD=
 
 SESSION_DRIVER=database
 SESSION_LIFETIME=120
-SESSION_ENCRYPT=false
+SESSION_ENCRYPT=true
 SESSION_PATH=/
 SESSION_DOMAIN=null
 # Set to true in production, where the site is served over HTTPS.
-SESSION_SECURE_COOKIE=false
+SESSION_SECURE_COOKIE=true
 
 BROADCAST_CONNECTION=log
 
diff --git a/public/.htaccess b/public/.htaccess
index b574a59..7bb1daf 100644
--- a/public/.htaccess
+++ b/public/.htaccess
@@ -1,3 +1,9 @@
+# Force browsers to use HTTPS only (HSTS). Only enable once HTTPS is
+# confirmed working on the domain, which it is for fivestore.alwaysdata.net.
+<IfModule mod_headers.c>
+    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
+</IfModule>
+
 <IfModule mod_rewrite.c>
     <IfModule mod_negotiation.c>
         Options -MultiViews -Indexes
