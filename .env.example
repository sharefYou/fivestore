APP_NAME="Five Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the hostname the site is served from.
APP_URL=http://localhost:8000

# The storefront serves /ar and /en. APP_LOCALE also decides the language of
# the admin panel, and with it whether the panel renders right to left.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=five_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production, where the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

# Catalog images are public files served from /storage, so the public disk is
# required. Run `php artisan storage:link` once after installing.
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

# Livewire writes in-progress uploads here. It must not be a publicly served
# disk, or half-finished uploads would be reachable under /storage before any
# validation has accepted them.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
